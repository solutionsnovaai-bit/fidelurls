# Banco Postgres (o Neon da Vercel preenche sozinho)
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Opcional: se existir, o painel passa a pedir essa senha. Vazio = acesso livre.
SENHA_PAINEL=

# Opcional: fixa o domínio dos links curtos (ex.: https://seudominio.com)
PUBLIC_BASE_URL=

# Opcional (só com senha ligada): chave para criar links por fora (Make, scripts)
API_KEY=
