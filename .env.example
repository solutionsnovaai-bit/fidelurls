# Senha para entrar no painel (obrigatória)
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Banco Postgres (o Neon da Vercel preenche sozinho)
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Opcional: fixa o domínio dos links curtos (ex.: https://seudominio.com)
PUBLIC_BASE_URL=

# Opcional: chave para criar links por fora (Make, scripts)
API_KEY=
