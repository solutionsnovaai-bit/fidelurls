{
  "name": "Fidel URLs",
  "short_name": "Fidel URLs",
  "description": "Cole um link ou IP, dê um nome e receba um link curto mascarado.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "lang": "pt-BR",
  "icons": [
    { "src": "/_fidel/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/_fidel/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "/_fidel/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
